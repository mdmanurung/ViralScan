import os
import yaml

from viralscan.chemistry import kb_whitelist_arg


def _all_targets(wildcards):
    """Collect all required outputs, adding optional targets when enabled."""
    targets = [
        f"{config['output']}config.yaml",
        f"{config['output']}log/umap.done",
    ]
    if config.get("host_h5ad"):
        targets.append(f"{config['output']}log/hostresponse.done")
    # menu.py serializes booleans as the strings "true"/"false" for
    # `snakemake --config`, so a bare truthiness check here is always True
    # (both are non-empty strings) regardless of the actual flag value.
    if str(config.get("gene_programs", "")).lower() == "true":
        targets.append(f"{config['output']}log/gene_programs.done")
    return targets


# rule all must be the first rule so Snakemake uses it as the default target
# even when optional rules are conditionally defined below.
rule all:
    input: _all_targets


# ── Host pre-subtraction (optional) ──────────────────────────────────────────
# When config["host_index"] is set the host_filter rule runs before kb_count.
# menu.py passes config["kb_r1"] / config["kb_r2"] pointing at either the
# original or filtered FASTQs, so the kb_count shell block needs no conditional
# logic.
def _kb_count_inputs(wildcards):
    """kb_count always needs the config; also waits for host_filter when active."""
    inputs = [
        f"{config['output']}config.yaml",
        f"{config['output']}log/create_config.done",
    ]
    if config.get("host_index"):
        # List the filtered FASTQs explicitly so Snakemake tracks the file
        # dependency, not just the sentinel.
        inputs.append(f"{config['output']}host_filtered/R1.fastq.gz")
        inputs.append(f"{config['output']}host_filtered/R2.fastq.gz")
        inputs.append(f"{config['output']}log/host_filter.done")
    return inputs


if config.get("host_index"):
    rule host_filter:
        input:
            f"{config['output']}log/create_config.done",
            f"{config['output']}config.yaml",
        output:
            r1   = f"{config['output']}host_filtered/R1.fastq.gz",
            r2   = f"{config['output']}host_filtered/R2.fastq.gz",
            done = f"{config['output']}log/host_filter.done",
        threads: config.get("cores", 6)
        params:
            configfile = lambda wildcards: f"{config['output']}config.yaml"
        script:
            "scripts/host_filter.py"
        
rule create_config:
    output:
        f"{config['output']}log/create_config.done",
        f"{config['output']}config.yaml"
    script:
        "scripts/createconfig.py"

rule kb_count:
    input:
        _kb_count_inputs
    output:
        f"{config['output']}log/kb.done"
    params:
        # Snakemake parses an empty `--config whitelist=` as None, and a shell
        # template renders None as the literal string "None". `kb count -w None`
        # means "bypass barcode error correction", so every run without -w used
        # to skip correction silently. Resolve "unset" here, in Python. The one
        # deliberate "None" is a chemistry with no official on-list (SW-21).
        whitelist = lambda wildcards: kb_whitelist_arg(
            config.get("technology", ""), config.get("whitelist")
        ),
        # Same None -> "None" hazard (SW-13): `--strand None` would be rejected by
        # kb. Unset means "kb's per-technology default", so omit the flag.
        strand = lambda wildcards: config.get("strand") or "",
    shell:
        """
        echo -e "\033[0;33mStarting to quantify the data...\033[0m"

        # bustools cannot read a GZIPPED whitelist: it reads the compressed bytes
        # as barcodes and dies with "on-list file malformed" — kb count then leaves
        # counts_unfiltered/ unwritten. Decompress the whitelist first if needed.
        WL={params.whitelist:q}
        WL_PLAIN=""
        case "$WL" in
            *.gz)
                WL_PLAIN={config[output]:q}whitelist_plain.txt
                zcat "$WL" > "$WL_PLAIN"
                WL="$WL_PLAIN"
                ;;
        esac

        # Do NOT swallow kb's output — tee it to a log so failures are visible.
        KB_LOG={config[output]:q}kb_count.log
        ST={params.strand:q}
        # Empty ST expands to nothing, so kb keeps its per-technology default.
        # No -w lets kb use its pre-packaged on-list for the technology.
        if [ -z "$WL" ]; then
            kb count -i {config[index]:q} -g {config[transcripts]:q} --overwrite -o {config[output]:q} -x {config[technology]:q} ${{ST:+--strand "$ST"}} {config[kb_r1]:q} {config[kb_r2]:q} --h5ad > "$KB_LOG" 2>&1
        else
            kb count -i {config[index]:q} -g {config[transcripts]:q} --overwrite -o {config[output]:q} -x {config[technology]:q} -w "$WL" ${{ST:+--strand "$ST"}} {config[kb_r1]:q} {config[kb_r2]:q} --h5ad > "$KB_LOG" 2>&1
        fi

        [ -n "$WL_PLAIN" ] && rm -f "$WL_PLAIN"

        if grep -qi "no reads pseudoaligned" "$KB_LOG"; then
            echo -e "\033[0;31mERROR: kb count failed! No reads pseudoaligned. Check your sample or reference index.\033[0m"
            tail -30 "$KB_LOG" >&2
            exit 1
        fi

        # Verify by artifact, not exit code: kb can exit 0 with no counts.
        if [ ! -d {config[output]:q}counts_unfiltered ]; then
            echo -e "\033[0;31mERROR: kb count produced no counts_unfiltered/. Last kb_count.log lines:\033[0m" >&2
            tail -40 "$KB_LOG" >&2
            exit 1
        fi

        echo -e "\033[0;32mQuantifying the data is done!\033[0m"
        mkdir -p {config[output]:q}kb-python/
        mv {config[output]:q}*.* {config[output]:q}kb-python/
        mv {config[output]:q}counts_unfiltered/ {config[output]:q}kb-python/
        mv {config[output]:q}kb-python/config.yaml {config[output]:q}
        touch {output:q}
        """

rule analysis:
    input:
        f"{config['output']}config.yaml",
        f"{config['output']}log/kb.done"
    output:
        f"{config['output']}log/analysis.txt",
        f"{config['output']}results/virus_identity.tsv"
    params:
        configfile = lambda wildcards: f"{config['output']}config.yaml"
    script:
        "scripts/analysis.py"

rule multimap:
    input:
        file_viral_accessions = f"{config['output']}log/analysis.txt",
        virus_identity = f"{config['output']}results/virus_identity.tsv"
    output:
        f"{config['output']}log/multimap.done"
    params:
        configfile = lambda wildcards: f"{config['output']}config.yaml",
        snakefile_dir = lambda wildcards: workflow.basedir
    script:
        "scripts/multimap.py"

rule detection:
    input:
        file_viral_accessions = f"{config['output']}log/analysis.txt",
        virus_identity = f"{config['output']}results/virus_identity.tsv",
        multimap_done = f"{config['output']}log/multimap.done"
    output:
        f"{config['output']}log/detection.done"
    params:
        configfile = lambda wildcards: f"{config['output']}config.yaml",
        snakefile_dir = lambda wildcards: workflow.basedir
    script:
        "scripts/detection.py"

rule umap:
    input:
        f"{config['output']}config.yaml",
        f"{config['output']}results/virus_identity.tsv",
        f"{config['output']}log/detection.done"
    output:
        f"{config['output']}log/umap.done"
    params:
        configfile = lambda wildcards: f"{config['output']}config.yaml"
    script:
        "scripts/umap.py"


# ── Gene-programme inference (optional, layer 2) ─────────────────────────────
# Second layer, over viruses the detection rule above already called. It reads
# results/viral_summary.tsv for its scope and the multimap H5AD for the
# counts_unique_viral layer it trusts. Kept optional because it only has a
# programme model for nine viruses, and because a programme call is meaningless
# for a virus the first layer did not detect.
if str(config.get("gene_programs", "")).lower() == "true":
    rule gene_programs:
        input:
            detection_done = f"{config['output']}log/detection.done",
            summary = f"{config['output']}results/viral_summary.tsv",
        output:
            f"{config['output']}log/gene_programs.done"
        params:
            configfile = lambda wildcards: f"{config['output']}config.yaml"
        script:
            "scripts/gene_programs.py"

# ── Host-response module (optional) ──────────────────────────────────────────
# When config["host_h5ad"] is set, run logistic regression associating virus
# presence with host gene expression (Luebbert et al. 2026 approach).
if config.get("host_h5ad"):
    rule hostresponse:
        input:
            umap_done = f"{config['output']}log/umap.done",
            analysis  = f"{config['output']}log/analysis.txt",
            virus_identity = f"{config['output']}results/virus_identity.tsv",
        output:
            f"{config['output']}log/hostresponse.done",
        params:
            configfile = lambda wildcards: f"{config['output']}config.yaml"
        script:
            "scripts/hostresponse.py"

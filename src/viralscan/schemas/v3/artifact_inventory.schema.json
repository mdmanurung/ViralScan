{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viralscan.dev/schemas/v3/artifact_inventory.schema.json",
  "title": "ViralScan v3 claim-bearing artifact inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_id",
        "kind",
        "path",
        "scope",
        "software_version",
        "counting_version",
        "git_sha",
        "input_sha256s",
        "reference_sha256s",
        "artifact_sha256",
        "schema",
        "layer",
        "denominator",
        "generation_command",
        "rebuild_eligibility",
        "claim_ids"
      ],
      "properties": {
        "schema_version": {"const": "1.1.0"},
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "kind": {
          "enum": [
            "input",
            "reference",
            "intermediate",
            "result",
            "validation_receipt",
            "command",
            "environment",
            "scheduler_record",
            "failure_record",
            "schema",
            "documentation"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "scope": {"enum": ["public", "private"]},
        "software_version": {"type": "string", "minLength": 1},
        "counting_version": {"type": "string", "minLength": 1},
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "input_sha256s": {
          "type": "array",
          "items": {"$ref": "#/$defs/hash_record"}
        },
        "reference_sha256s": {
          "type": "array",
          "items": {"$ref": "#/$defs/hash_record"}
        },
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"type": "string", "minLength": 1},
        "layer": {"type": "string", "minLength": 1},
        "denominator": {"type": "string", "minLength": 1},
        "generation_command": {"type": "string", "minLength": 1},
        "rebuild_eligibility": {
          "enum": ["rebuildable", "retained_only", "external_blocked", "not_applicable"]
        },
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        }
      }
    }
  }
}

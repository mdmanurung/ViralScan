# Template only: a release must supply the tested OCI digest, never solve again.
# Generate the buildable definition:
# python scripts/release_sif_definition.py ghcr.io/mdmanurung/viralscan@sha256:<digest> > Singularity.release.def
# apptainer build viralscan.sif Singularity.release.def
Bootstrap: docker
From: OCI_DIGEST_REQUIRED

%labels
    Author emma.vonk@hotmail.nl
    Version 3.0.0rc1
    Description ViralScan - viral load quantification from scRNA-seq

%environment
    export PATH="/opt/conda/envs/viralscan/bin:$PATH"

%runscript
    exec /opt/conda/envs/viralscan/bin/viralscan "$@"

%test
    /opt/conda/envs/viralscan/bin/viralscan doctor --profile full

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viralscan.dev/schemas/v3/validation_protocol.schema.json",
  "title": "ViralScan v3 scientific validation protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "protocol_version",
    "target_release",
    "title",
    "status",
    "created_at",
    "freeze",
    "supported_scope",
    "harmonization",
    "hypotheses",
    "endpoints",
    "datasets",
    "factors",
    "seeds",
    "references",
    "exclusions",
    "execution_readiness",
    "planned_freeze_sections"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "protocol_id": {"const": "viralscan-v3-validation"},
    "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "target_release": {"const": "3.0.0"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "frozen", "amended", "retired"]},
    "created_at": {"type": "string", "format": "date-time"},
    "freeze": {"$ref": "#/$defs/freeze"},
    "supported_scope": {"$ref": "#/$defs/supportedScope"},
    "harmonization": {"$ref": "#/$defs/harmonization"},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/hypothesis"}
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/endpoint"}
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dataset"}
    },
    "factors": {
      "type": "array",
      "minItems": 9,
      "items": {"$ref": "#/$defs/factor"}
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivation", "root", "generation", "split", "cell_calling", "evidence_sampling", "bootstrap"],
      "properties": {
        "derivation": {"type": "string", "minLength": 1},
        "root": {"$ref": "#/$defs/integerDecision"},
        "generation": {"$ref": "#/$defs/integerDecision"},
        "split": {"$ref": "#/$defs/integerDecision"},
        "cell_calling": {"$ref": "#/$defs/integerDecision"},
        "evidence_sampling": {"$ref": "#/$defs/integerDecision"},
        "bootstrap": {"$ref": "#/$defs/integerDecision"}
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reference"}
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/exclusion"}
    },
    "execution_readiness": {"$ref": "#/$defs/executionReadiness"},
    "planned_freeze_sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_universe",
        "feature_universe",
        "count_layers_denominators",
        "partitions",
        "calibration_metrics_lod",
        "workflow_matrix",
        "failure_and_deviation_reporting",
        "independent_review"
      ],
      "properties": {
        "cell_universe": {"$ref": "#/$defs/plannedSection"},
        "feature_universe": {"$ref": "#/$defs/plannedSection"},
        "count_layers_denominators": {"$ref": "#/$defs/plannedSection"},
        "partitions": {"$ref": "#/$defs/plannedSection"},
        "calibration_metrics_lod": {"$ref": "#/$defs/plannedSection"},
        "workflow_matrix": {"$ref": "#/$defs/plannedSection"},
        "failure_and_deviation_reporting": {"$ref": "#/$defs/plannedSection"},
        "independent_review": {"$ref": "#/$defs/plannedSection"}
      }
    },
    "principal_risks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "frozen"}}, "required": ["status"]},
      "then": {
        "properties": {
          "freeze": {
            "properties": {
              "training_execution_allowed": {"const": true},
              "frozen_at": {"type": "string", "format": "date-time"},
              "freeze_manifest": {"type": "string", "minLength": 1}
            },
            "required": ["frozen_at", "freeze_manifest"]
          },
          "execution_readiness": {
            "properties": {
              "training_allowed": {"const": true},
              "training_blockers": {"maxItems": 0}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_execution_allowed",
        "holdout_execution_allowed",
        "freeze_manifest",
        "frozen_at",
        "training_results_sha256",
        "thresholds_sha256"
      ],
      "properties": {
        "training_execution_allowed": {"type": "boolean"},
        "holdout_execution_allowed": {"type": "boolean"},
        "freeze_manifest": {"type": ["string", "null"]},
        "frozen_at": {"type": ["string", "null"], "format": "date-time"},
        "training_results_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "thresholds_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "note": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"holdout_execution_allowed": {"const": true}},
            "required": ["holdout_execution_allowed"]
          },
          "then": {
            "properties": {
              "training_results_sha256": {"$ref": "#/$defs/sha256"},
              "thresholds_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "chemistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cell_barcode_length", "umi_length"],
      "properties": {
        "id": {"enum": ["10xv2", "10xv3", "drop-seq"]},
        "cell_barcode_length": {"type": "integer", "minimum": 1},
        "umi_length": {"type": "integer", "minimum": 1}
      }
    },
    "supportedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_species", "assay", "read_layout", "chemistries", "primary_workflow", "primary_allocation", "cross_tool_primary_layer", "excluded_assays"],
      "properties": {
        "host_species": {"const": "homo_sapiens"},
        "assay": {"const": "droplet-scrna-seq"},
        "read_layout": {"const": "paired-end"},
        "chemistries": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/chemistry"}
        },
        "primary_workflow": {"const": "combined-host-plus-virus"},
        "primary_allocation": {"const": "host-conservative"},
        "cross_tool_primary_layer": {"const": "counts_unique"},
        "excluded_assays": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "harmonization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "resolution_task",
        "frozen_at",
        "contract_sha256",
        "dependent_fields_sha256",
        "normative_precedence",
        "decision_timing",
        "outcome_blinding",
        "barcode_normalization",
        "cell_universe",
        "feature_universe",
        "count_layers",
        "molecule_truth_projection",
        "denominators",
        "endpoint_denominator_map",
        "derived_metric_rules",
        "row_failure_policy",
        "audit_artifacts"
      ],
      "properties": {
        "status": {"const": "frozen"},
        "resolution_task": {"const": "SCI-02"},
        "frozen_at": {"type": "string", "format": "date-time"},
        "contract_sha256": {"const": "699854b71169222e74d26c2119f1c9d7742d5962ac4ed8c02dfa9f288e3339dc"},
        "dependent_fields_sha256": {"const": "fd818661a8d06f28c5c23e78bfb1c5b48b151023f5f749453260d023adbff333"},
        "normative_precedence": {"const": "harmonization-controls-cell-feature-layer-and-denominator-semantics"},
        "decision_timing": {"const": "before-any-viral-outcome-is-inspected"},
        "outcome_blinding": {"$ref": "#/$defs/outcomeBlinding"},
        "barcode_normalization": {"$ref": "#/$defs/barcodeNormalization"},
        "cell_universe": {"$ref": "#/$defs/cellUniverse"},
        "feature_universe": {"$ref": "#/$defs/featureUniverse"},
        "count_layers": {"$ref": "#/$defs/countLayers"},
        "molecule_truth_projection": {"$ref": "#/$defs/moleculeTruthProjection"},
        "denominators": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {"$ref": "#/$defs/denominator"}
        },
        "endpoint_denominator_map": {"$ref": "#/$defs/endpointDenominatorMap"},
        "derived_metric_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cell_f1", "zero_division"],
          "properties": {
            "cell_f1": {"const": "two-times-precision-times-recall-divided-by-precision-plus-recall"},
            "zero_division": {"const": "report-not-estimable-never-zero-impute"}
          }
        },
        "row_failure_policy": {"$ref": "#/$defs/rowFailurePolicy"},
        "audit_artifacts": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/auditArtifact"}
        }
      }
    },
    "outcomeBlinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_independent", "allowed_inputs", "prohibited_inputs", "violation_policy", "violation_action"],
      "properties": {
        "outcome_independent": {"const": true},
        "allowed_inputs": {
          "type": "array",
          "minItems": 4,
          "items": {
            "enum": [
              "synthetic-droplet-membership-with-infection-labels-hidden",
              "externally-supplied-called-cell-list-created-without-viral-outcomes",
              "host-only-gene-count-matrix",
              "frozen-reference-annotation-and-tool-capability-manifests"
            ]
          },
          "uniqueItems": true
        },
        "prohibited_inputs": {
          "type": "array",
          "minItems": 5,
          "items": {
            "enum": [
              "viral-count-matrix",
              "viral-summary-or-evidence-tier",
              "known-infected-cell-label",
              "comparator-viral-output",
              "tool-positive-or-filtered-barcode-intersection"
            ]
          },
          "uniqueItems": true
        },
        "violation_policy": {"type": "string", "minLength": 1},
        "violation_action": {"const": "quarantine-rerun-record-deviation"}
      }
    },
    "barcodeNormalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "canonical_key",
        "trim_ascii_outer_whitespace",
        "case_rule",
        "canonical_alphabet_regex",
        "chemistry_length_source",
        "terminal_gem_group_suffix_regex",
        "terminal_suffix_rule",
        "preserve_internal_hyphens",
        "lane_merge_rule",
        "cross_library_matching",
        "uniqueness_required",
        "collision_policy"
      ],
      "properties": {
        "scope": {"const": "within-library-only"},
        "canonical_key": {"const": "library-id-double-colon-cb-sequence-optional-double-colon-gem-group"},
        "trim_ascii_outer_whitespace": {"const": true},
        "case_rule": {"const": "uppercase-canonical-retain-raw"},
        "canonical_alphabet_regex": {"const": "^[ACGT]+$"},
        "chemistry_length_source": {"const": "supported-scope-chemistry"},
        "terminal_gem_group_suffix_regex": {"const": "-[1-9][0-9]*$"},
        "terminal_suffix_rule": {"type": "string", "minLength": 1},
        "preserve_internal_hyphens": {"const": true},
        "lane_merge_rule": {"type": "string", "minLength": 1},
        "cross_library_matching": {"const": "forbidden"},
        "uniqueness_required": {"const": true},
        "collision_policy": {"const": "fail-dataset-preflight-and-retain-planned-rows"}
      }
    },
    "cellUniverse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "source_precedence",
        "synthetic_rule",
        "public_data_rule",
        "host_only_emptydrops",
        "required_before_outcome_runs",
        "common_across_workflow_rows",
        "outcome_selection",
        "primary_cell_metric_population",
        "negative_specificity_population",
        "empty_droplet_population",
        "sensitivity_only_callers",
        "missing_anchor_barcode_policy",
        "extra_output_barcode_policy",
        "public_positive_role",
        "invalid_primary_sources",
        "no_valid_anchor_policy"
      ],
      "properties": {
        "id": {"const": "shared_outcome_independent_called_cells"},
        "scope": {"const": "one-frozen-anchor-per-dataset-library"},
        "source_precedence": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"const": "synthetic-truth-droplet-membership"},
            {"const": "external-outcome-independent-called-cell-list"},
            {"const": "shared-host-only-emptydrops"}
          ]
        },
        "synthetic_rule": {"type": "string", "minLength": 1},
        "public_data_rule": {"type": "string", "minLength": 1},
        "host_only_emptydrops": {"$ref": "#/$defs/hostOnlyEmptydrops"},
        "required_before_outcome_runs": {"const": true},
        "common_across_workflow_rows": {"const": true},
        "outcome_selection": {"const": "forbidden"},
        "primary_cell_metric_population": {"const": "shared-called-cell-anchor"},
        "negative_specificity_population": {"const": "shared-called-cell-anchor"},
        "empty_droplet_population": {"const": "prespecified-empty-droplet-barcodes-reported-separately"},
        "sensitivity_only_callers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"enum": ["knee", "none"]},
          "uniqueItems": true
        },
        "missing_anchor_barcode_policy": {"const": "structural-zero-only-with-complete-declared-barcode-domain-otherwise-row-failure"},
        "extra_output_barcode_policy": {"const": "exclude-from-primary-and-count-in-integrity-audit"},
        "public_positive_role": {"const": "context-only-no-cell-level-truth"},
        "invalid_primary_sources": {
          "type": "array",
          "minItems": 5,
          "items": {
            "enum": [
              "per-tool-called-cells",
              "union-of-tool-output-barcodes",
              "intersection-of-tool-output-barcodes",
              "viral-positive-barcodes",
              "per-cell-viral-table"
            ]
          },
          "uniqueItems": true
        },
        "no_valid_anchor_policy": {"const": "mark-all-anchor-restricted-endpoints-incomparable-and-retain-row"}
      }
    },
    "hostOnlyEmptydrops": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caller", "matrix", "fdr", "lower", "niters", "seed_source", "fallback", "version_requirement"],
      "properties": {
        "caller": {"const": "DropletUtils::emptyDrops"},
        "matrix": {"const": "raw-host-only-gene-molecule-matrix"},
        "fdr": {"const": 0.01},
        "lower": {"const": 100},
        "niters": {"const": 10000},
        "seed_source": {"const": "seeds.cell_calling"},
        "fallback": {"const": "forbidden"},
        "version_requirement": {"const": "exact-version-and-container-digest-in-SCI-04-workflow-row"}
      }
    },
    "featureUniverse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projection",
        "source",
        "primary_rule",
        "identifier_resolution",
        "accession_version_policy",
        "sibling_virus_policy",
        "primary_mapping_cardinality",
        "zero_count_features",
        "observed_count_selection",
        "expected_target_selection",
        "full_panel_role",
        "expected_targets_role",
        "allowed_matching",
        "prohibited_matching",
        "secondary_total_expression_rule",
        "unmappable_row_policy",
        "empty_intersection_policy",
        "amendment_rule"
      ],
      "properties": {
        "id": {"const": "frozen_common_target_gene_intersection"},
        "projection": {"const": "transcripts-to-distinct-compatible-genes-before-ambiguity-classification"},
        "source": {"const": "frozen-reference-and-tool-capability-manifests-before-count-matrices"},
        "primary_rule": {"type": "string", "minLength": 1},
        "identifier_resolution": {"const": "explicit-versioned-accession-transcript-gene-map"},
        "accession_version_policy": {"const": "preserve"},
        "sibling_virus_policy": {"const": "retain-as-distinct-targets"},
        "primary_mapping_cardinality": {"const": "exact-one-to-one"},
        "zero_count_features": {"const": "retain"},
        "observed_count_selection": {"const": "forbidden"},
        "expected_target_selection": {"const": "forbidden"},
        "full_panel_role": {"const": "contextual-off-target-and-sibling-reporting"},
        "expected_targets_role": {"const": "context-and-stratification-only"},
        "allowed_matching": {
          "type": "array",
          "minItems": 2,
          "items": {"enum": ["exact-gene-id", "explicit-audited-alias"]},
          "uniqueItems": true
        },
        "prohibited_matching": {
          "type": "array",
          "minItems": 4,
          "items": {"enum": ["substring", "prefix", "case-folding", "outcome-driven-feature-rescue"]},
          "uniqueItems": true
        },
        "secondary_total_expression_rule": {"type": "string", "minLength": 1},
        "unmappable_row_policy": {"const": "mark-affected-endpoint-incomparable-and-retain-row"},
        "empty_intersection_policy": {"const": "mark-comparison-incomparable-and-retain-all-rows"},
        "amendment_rule": {"type": "string", "minLength": 1}
      }
    },
    "countLayers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_primary",
        "cross_tool_primary",
        "evidence_tier_input",
        "secondary_ambiguity_aware",
        "terminology_rule",
        "layer_consistency_rule",
        "cross_layer_library_normalization"
      ],
      "properties": {
        "product_primary": {"$ref": "#/$defs/productPrimaryLayer"},
        "cross_tool_primary": {"$ref": "#/$defs/crossToolPrimaryLayer"},
        "evidence_tier_input": {"$ref": "#/$defs/evidenceTierInput"},
        "secondary_ambiguity_aware": {"$ref": "#/$defs/secondaryLayer"},
        "terminology_rule": {"type": "string", "minLength": 1},
        "layer_consistency_rule": {"type": "string", "minLength": 1},
        "cross_layer_library_normalization": {"const": "forbidden"}
      }
    },
    "productPrimaryLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "viralscan_source", "allocation_method", "unit", "composition"],
      "properties": {
        "id": {"const": "viralscan-selected-total"},
        "viralscan_source": {"const": "X"},
        "allocation_method": {"const": "host-conservative"},
        "unit": {"const": "molecule-estimate"},
        "composition": {"const": "counts_unique-plus-counts_ambiguous_allocated"}
      }
    },
    "crossToolPrimaryLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "viralscan_source",
        "unit",
        "cell_universe",
        "feature_universe",
        "comparator_requirement",
        "adapter_required_fields",
        "adapter_unit",
        "adapter_ambiguity_rule",
        "algorithmic_differences",
        "matrix_selection",
        "missing_equivalent_policy",
        "incompatible_unit_policy"
      ],
      "properties": {
        "id": {"const": "unique-only-parity"},
        "viralscan_source": {"const": "counts_unique"},
        "unit": {"const": "integer-unique-molecule"},
        "cell_universe": {"const": "shared_outcome_independent_called_cells"},
        "feature_universe": {"const": "frozen_common_target_gene_intersection"},
        "comparator_requirement": {"const": "documented-gene-unique-integer-CB-UMI-molecule-output"},
        "adapter_required_fields": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"enum": ["artifact", "field", "unit", "integer_status", "umi_collapse_semantics", "ambiguity_rule", "barcode_domain", "feature_manifest_sha256"]},
          "uniqueItems": true
        },
        "adapter_unit": {"const": "molecule"},
        "adapter_ambiguity_rule": {"const": "gene-unique-only"},
        "algorithmic_differences": {"const": "preregistered-and-reported"},
        "matrix_selection": {"const": "raw-unfiltered-output-subset-once-to-frozen-cells-and-features"},
        "missing_equivalent_policy": {"const": "mark-primary-parity-incomparable-and-retain-row"},
        "incompatible_unit_policy": {"const": "read-counts-and-fractional-estimates-are-secondary-only"}
      }
    },
    "evidenceTierInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "molecule_source", "allocation_method", "read_qc_source", "cell_score_requirement", "calibration_scope"],
      "properties": {
        "id": {"const": "viralscan-product-evidence"},
        "molecule_source": {"const": "X"},
        "allocation_method": {"const": "host-conservative"},
        "read_qc_source": {"const": "exact-read-evidence"},
        "cell_score_requirement": {"const": "one-continuous-score-id-frozen-in-SCI-03"},
        "calibration_scope": {"const": "training-only"}
      }
    },
    "secondaryLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "viralscan_source", "viralscan_allocated_component", "unit", "comparison_rule"],
      "properties": {
        "id": {"const": "tool-recommended-ambiguity-aware"},
        "viralscan_source": {"const": "X"},
        "viralscan_allocated_component": {"const": "counts_ambiguous_allocated"},
        "unit": {"const": "molecule-estimate"},
        "comparison_rule": {"type": "string", "minLength": 1}
      }
    },
    "moleculeTruthProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corrected_key",
        "correction_contract",
        "gene_projection",
        "collision_rule",
        "adapter_rule",
        "eligibility_rule",
        "truth_classes",
        "ambiguous_reporting"
      ],
      "properties": {
        "corrected_key": {"const": "library-id-double-colon-corrected-CB-double-colon-corrected-UMI"},
        "correction_contract": {"const": "outcome-independent-canonical-truth-normalizer-frozen-by-VAL-09"},
        "gene_projection": {"const": "ECs-to-distinct-compatible-genes"},
        "collision_rule": {"const": "one-corrected-key-contributes-at-most-one-truth-molecule"},
        "adapter_rule": {"type": "string", "minLength": 1},
        "eligibility_rule": {"type": "string", "minLength": 1},
        "truth_classes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"enum": ["unique", "ambiguous", "unresolved"]},
          "uniqueItems": true
        },
        "ambiguous_reporting": {"const": "separate-from-primary-unique-only-scoring"}
      }
    },
    "endpointDenominatorMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "E1_count_invariants",
        "E2_negative_false_calls",
        "E3_molecule_recovery",
        "E4_cell_recovery",
        "E5_sibling_confusion",
        "E6_host_virus_allocation",
        "E7_two_step_loss",
        "E8_limit_of_detection",
        "E9_tier_calibration",
        "E10_cross_tool_parity"
      ],
      "properties": {
        "E1_count_invariants": {"$ref": "#/$defs/denominatorIdList"},
        "E2_negative_false_calls": {"$ref": "#/$defs/denominatorIdList"},
        "E3_molecule_recovery": {"$ref": "#/$defs/denominatorIdList"},
        "E4_cell_recovery": {"$ref": "#/$defs/denominatorIdList"},
        "E5_sibling_confusion": {"$ref": "#/$defs/denominatorIdList"},
        "E6_host_virus_allocation": {"$ref": "#/$defs/denominatorIdList"},
        "E7_two_step_loss": {"$ref": "#/$defs/denominatorIdList"},
        "E8_limit_of_detection": {"$ref": "#/$defs/denominatorIdList"},
        "E9_tier_calibration": {"$ref": "#/$defs/denominatorIdList"},
        "E10_cross_tool_parity": {"$ref": "#/$defs/denominatorIdList"}
      }
    },
    "denominatorIdList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^D[0-9]+_[a-z0-9_]+$"},
      "uniqueItems": true
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "numerator", "denominator", "population", "count_layer", "missing_output"],
      "properties": {
        "id": {
          "enum": [
            "D1_count_invariant_runs",
            "D2_unique_molecule_precision",
            "D3_unique_molecule_recall",
            "D4_infected_cell_precision",
            "D5_infected_cell_recall",
            "D6_infected_cell_auprc",
            "D7_exact_negative_cell_false_calls",
            "D8_exact_negative_sample_false_calls",
            "D9_exact_negative_molecule_false_calls",
            "D10_presumed_negative_unexpected_calls",
            "D11_empty_droplet_false_calls",
            "D12_positive_cell_rate",
            "D13_sibling_molecule_confusion",
            "D14_host_virus_allocation",
            "D15_two_step_truth_read_loss",
            "D16_two_step_truth_molecule_loss",
            "D17_lod_detection_probability",
            "D18_tier_specificity",
            "D19_tier_ppv",
            "D20_cross_tool_absolute_unique",
            "D21_secondary_burden_per_10000",
            "D22_workflow_technical_failure_rate",
            "D23_endpoint_incomparability_rate",
            "D24_sibling_cell_confusion"
          ]
        },
        "class": {"enum": ["primary", "secondary", "safety", "resource"]},
        "numerator": {"type": "string", "minLength": 1},
        "denominator": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "count_layer": {"type": "string", "minLength": 1},
        "missing_output": {"type": "string", "minLength": 1}
      }
    },
    "rowFailurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain_all_prespecified_rows",
        "accuracy_value_for_missing_output",
        "include_in_failure_denominator",
        "impute_accuracy",
        "silent_row_omission",
        "row_execution_statuses",
        "endpoint_comparability_statuses",
        "technical_noncompletion_statuses",
        "complete_requires_artifact_hashes",
        "noncomplete_metric_value",
        "retry_rule",
        "primary_claim_rule"
      ],
      "properties": {
        "retain_all_prespecified_rows": {"const": true},
        "accuracy_value_for_missing_output": {"const": "not-estimable"},
        "include_in_failure_denominator": {"const": true},
        "impute_accuracy": {"const": false},
        "silent_row_omission": {"const": "forbidden"},
        "row_execution_statuses": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"enum": ["not_started", "complete", "failed", "timeout", "oom", "invalid_input", "unsupported"]},
          "uniqueItems": true
        },
        "endpoint_comparability_statuses": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"enum": ["comparable", "incomparable", "not_applicable"]},
          "uniqueItems": true
        },
        "technical_noncompletion_statuses": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"enum": ["not_started", "failed", "timeout", "oom", "invalid_input", "unsupported"]},
          "uniqueItems": true
        },
        "complete_requires_artifact_hashes": {"const": true},
        "noncomplete_metric_value": {"type": "null"},
        "retry_rule": {"type": "string", "minLength": 1},
        "primary_claim_rule": {"type": "string", "minLength": 1}
      }
    },
    "auditArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "required_columns"],
      "properties": {
        "path": {
          "enum": [
            "analysis/v3_validation/generated/cell_universe_manifest.tsv",
            "analysis/v3_validation/generated/barcode_normalization_audit.tsv",
            "analysis/v3_validation/generated/feature_universe.tsv",
            "analysis/v3_validation/generated/count_layer_map.tsv",
            "analysis/v3_validation/generated/denominator_audit.tsv",
            "analysis/v3_validation/generated/workflow_failures.tsv"
          ]
        },
        "required_columns": {
          "type": "array",
          "minItems": 6,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "statement", "endpoint_ids", "falsification_rule"],
      "properties": {
        "id": {"type": "string", "pattern": "^H[0-9]+_[a-z0-9_]+$"},
        "class": {"enum": ["primary", "secondary", "safety", "estimation"]},
        "statement": {"type": "string", "minLength": 1},
        "endpoint_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "falsification_rule": {"type": "string", "minLength": 1}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "unit", "estimand", "reporting", "acceptance_rule"],
      "properties": {
        "id": {"type": "string", "pattern": "^E[0-9]+_[a-z0-9_]+$"},
        "class": {"enum": ["primary", "secondary", "safety", "resource"]},
        "unit": {"type": "string", "minLength": 1},
        "estimand": {"type": "string", "minLength": 1},
        "reporting": {"type": "string", "minLength": 1},
        "acceptance_rule": {"type": "string", "minLength": 1}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "locator", "digest_status", "sha256", "freeze_required"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "locator": {"type": ["string", "null"]},
        "digest_status": {"enum": ["verified", "recorded-reverify", "pending", "not-applicable"]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "freeze_required": {"type": "boolean"},
        "hash_source": {"type": ["string", "null"]},
        "pending_reason": {"type": ["string", "null"]},
        "resolution_task": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"digest_status": {"const": "verified"}}, "required": ["digest_status"]},
          "then": {"properties": {"sha256": {"$ref": "#/$defs/sha256"}}}
        },
        {
          "if": {"properties": {"digest_status": {"enum": ["pending", "recorded-reverify"]}}, "required": ["digest_status"]},
          "then": {
            "properties": {
              "pending_reason": {"type": "string", "minLength": 1},
              "resolution_task": {"type": "string", "minLength": 1}
            },
            "required": ["pending_reason", "resolution_task"]
          }
        }
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "class", "analysis_role", "truth_status", "source", "chemistries", "accessions", "assets", "expected_targets", "required", "exclusion_rule"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
        "label": {"type": "string", "minLength": 1},
        "class": {"enum": ["synthetic-truth", "synthetic-host-only", "adversarial-host-homology", "observational-negative", "public-positive", "reagent-control", "empty-droplet", "orthogonal-positive"]},
        "analysis_role": {"enum": ["training", "holdout", "training-and-holdout", "external-evaluation", "context-only", "claim-gating"]},
        "truth_status": {"enum": ["exact", "presumed-negative", "contextual", "orthogonal", "unavailable"]},
        "source": {"type": "string", "minLength": 1},
        "chemistries": {
          "type": "array",
          "items": {"enum": ["10xv2", "10xv3", "drop-seq"]},
          "uniqueItems": true
        },
        "accessions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
        "expected_targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required": {"type": "boolean"},
        "exclusion_rule": {"type": "string", "minLength": 1}
      }
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status", "levels", "resolution_task"],
      "properties": {
        "id": {"enum": ["viral_abundance", "infected_cell_fraction", "host_virus_homology", "sibling_virus_similarity", "low_complexity", "pcr_duplication", "cb_umi_collisions", "ambient_index_hopping", "chemistry"]},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "frozen"]},
        "levels": {"type": "array", "uniqueItems": true},
        "resolution_task": {"type": "string", "minLength": 1},
        "pending_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "frozen"}}, "required": ["status"]},
          "then": {"properties": {"levels": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]},
          "then": {
            "properties": {"pending_reason": {"type": "string", "minLength": 1}},
            "required": ["pending_reason"]
          }
        }
      ]
    },
    "integerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "resolution_task", "freeze_required"],
      "properties": {
        "status": {"enum": ["pending", "frozen"]},
        "value": {"type": ["integer", "null"], "minimum": 0},
        "resolution_task": {"type": "string", "minLength": 1},
        "freeze_required": {"type": "boolean"},
        "pending_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "frozen"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "integer", "minimum": 0}}}
        },
        {
          "if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]},
          "then": {
            "properties": {"pending_reason": {"type": "string", "minLength": 1}},
            "required": ["pending_reason"]
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "purpose", "host_release", "viral_panel", "assets"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
        "profile": {"enum": ["curated", "broad-discovery", "anellovirus-representative", "anellovirus-expanded"]},
        "purpose": {"type": "string", "minLength": 1},
        "host_release": {"type": ["string", "null"]},
        "viral_panel": {"type": ["string", "null"]},
        "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "rule", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^X[0-9]+_[a-z0-9_]+$"},
        "scope": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "executionReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_allowed",
        "holdout_allowed",
        "training_blockers",
        "holdout_blockers"
      ],
      "properties": {
        "training_allowed": {"type": "boolean"},
        "holdout_allowed": {"type": "boolean"},
        "training_blockers": {
          "type": "array",
          "items": {"$ref": "#/$defs/blocker"}
        },
        "holdout_blockers": {
          "type": "array",
          "items": {"$ref": "#/$defs/blocker"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"holdout_allowed": {"const": true}},
            "required": ["holdout_allowed"]
          },
          "then": {
            "properties": {
              "training_allowed": {"const": true},
              "holdout_blockers": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "resolution_task"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "resolution_task": {"type": "string", "minLength": 1}
      }
    },
    "plannedSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "resolution_task", "freeze_required", "description"],
      "properties": {
        "status": {"enum": ["pending", "frozen"]},
        "resolution_task": {"type": "string", "minLength": 1},
        "freeze_required": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}

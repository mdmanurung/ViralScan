{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viralscan.dev/schemas/v3/count_audit.schema.json",
  "title": "ViralScan v3 count audit row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_molecules",
    "resolved_molecules",
    "unique_molecules",
    "ambiguous_molecules",
    "unresolved_molecules",
    "ignored_read_multiplicity",
    "allocated_ambiguous_mass"
  ],
  "properties": {
    "input_molecules": {
      "type": "integer",
      "minimum": 0
    },
    "resolved_molecules": {
      "type": "integer",
      "minimum": 0
    },
    "unique_molecules": {
      "type": "integer",
      "minimum": 0
    },
    "ambiguous_molecules": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved_molecules": {
      "type": "integer",
      "minimum": 0
    },
    "ignored_read_multiplicity": {
      "type": "integer",
      "minimum": 0
    },
    "allocated_ambiguous_mass": {
      "type": "number",
      "minimum": 0
    },
    "barcode_correction": {
      "enum": [
        "viralscan",
        "kb",
        "none"
      ]
    },
    "bus_records_raw": {
      "type": "integer",
      "minimum": 0
    },
    "bus_records_after_correction": {
      "type": "integer",
      "minimum": 0
    },
    "offlist_dropped_records": {
      "type": "integer",
      "minimum": 0
    },
    "bus_reads_raw": {
      "type": "integer",
      "minimum": 0
    },
    "bus_reads_after_correction": {
      "type": "integer",
      "minimum": 0
    },
    "offlist_dropped_reads": {
      "type": "integer",
      "minimum": 0
    },
    "bus_totals_source": {
      "enum": [
        "bustools_inspect",
        "not_corrected"
      ]
    },
    "host_virus_ambiguous_molecules": {
      "type": "integer",
      "minimum": 0
    }
  }
}
